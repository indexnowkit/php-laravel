{
    "name": "indexnowkit/laravel",
    "description": "Laravel package for IndexNow: notify Yandex, Bing, Naver, Seznam and Yep when Eloquent models change. #[IndexNow] rules on models, commit-safe observers, queued submission, key file route, artisan commands.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "laravel",
        "eloquent",
        "seo",
        "yandex",
        "bing",
        "queue",
        "psr-18",
        "psr-3"
    ],
    "homepage": "https://indexnowkit.github.io/php/laravel/",
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-laravel",
        "docs": "https://github.com/indexnowkit/php-laravel/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-laravel/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "indexnowkit/console": "^0.4",
        "indexnowkit/core": "^0.13",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "indexnowkit/history": "^0.3",
        "indexnowkit/sitemap": "^0.8",
        "indexnowkit/testing": "^0.3",
        "indexnowkit/verify": "^0.4",
        "larastan/larastan": "^3.11",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "indexnowkit/history": "<0.3",
        "indexnowkit/sitemap": "<0.8",
        "indexnowkit/verify": "<0.4"
    },
    "suggest": {
        "indexnowkit/sitemap": "The indexnow:sitemap command (^0.8)",
        "indexnowkit/verify": "Pre-flight GET of every URL before submission — noindex, robots.txt, canonical, redirects (^0.4; verify.enabled: true)",
        "indexnowkit/history": "Submission history in a cache store or a database table, the indexnow:history and indexnow:status commands (^0.3; history.store: psr16|pdo)",
        "laravel/octane": "Supported: the collector is a scoped singleton and is flushed on terminate",
        "nyholm/psr7": "PSR-17 factories when no PSR-18 client is installed (any PSR-18 client works, e.g. guzzlehttp/guzzle ^7 which Laravel ships)"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable",
        "ci:install:lowest-l13": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable --with illuminate/support:^13.0 --with orchestra/testbench:^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IndexNowKit\\Laravel\\IndexNowKitServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.15.x-dev"
        }
    }
}
